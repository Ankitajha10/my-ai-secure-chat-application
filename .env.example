# ===================================================
# My AI – Environment Configuration Template
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ===================================================

# Google Gemini API Key (Required for LLM chat generation)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model
# Examples: gemini-3.5-flash, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.5-flash

# JWT Secret Key used for signing authentication tokens
# In production, use a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key

# Admin User Initialization
# IMPORTANT: Provide your own strong, secure admin password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
